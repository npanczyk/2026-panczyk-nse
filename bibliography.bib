@article{pigni_early_2017,
	title = {Early applications of the {R}-matrix {SAMMY} code for charged-particle induced reactions and related covariances},
	volume = {146},
	copyright = {© The Authors, published by EDP Sciences, 2017},
	issn = {2100-014X},
	zzzurl = {https://www.epj-conferences.org/articles/epjconf/abs/2017/15/epjconf-nd2016_02019/epjconf-nd2016_02019.html},
	doi = {10.1051/epjconf/201714602019},
	abstract = {The SAMMY code system is mainly used in nuclear data evaluations for incident {\textless}i{\textgreater}neutrons{\textless}i/{\textgreater} in the resolved resonance region (RRR), however, built-in capabilities also allow the code to describe the resonance structure produced by other incident particles, including charged particles. (α,n) data provide fundamental information that underpins nuclear modeling and simulation software, such as ORIGEN and SOURCES4C, used for the analysis of neutron emission and definition of source emission processes. The goal of this work is to carry out evaluations of charged-particle-induced reaction cross sections in the RRR. The SAMMY code was recently used in this regard to generate a Reich-Moore parameterization of the available {\textless}sup{\textgreater}17,18{\textless}sup/{\textgreater}O(α,n) experimental cross sections in order to estimate the uncertainty in the neutron generation rates for uranium oxide fuel types. This paper provides a brief description of the SAMMY evaluation procedure for the treatment of {\textless}sup{\textgreater}17,18{\textless}sup/{\textgreater}O(α,n) reaction cross sections. The results are used to generate neutron source rates for a plutonium oxide matrix.},
	language = {en},
	urldate = {2025-06-09},
	journal = {EPJ Web of Conferences},
	author = {Pigni et al., Marco T. },
	year = {2017},
	note = {Publisher: EDP Sciences},
	pages = {02019},
	file = {Full Text PDF:/Users/clover/Zotero/storage/WKENKKLF/Pigni et al. - 2017 - Early applications of the R-matrix SAMMY code for .pdf:application/pdf},
}

@article{derrien_r-matrix_2008,
