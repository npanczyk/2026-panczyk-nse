@misc{waltonAutomatedResonanceIdentification2024,
  title = {Automated {{Resonance Identification}} in {{Nuclear Data Evaluation}}},
  author = {Walton, Noah A. W. and Zivenko, Oleksii and Fritsch, William and Forbes, Jacob and Lewis, Amanda and Brown, Jesse and Sobes, Vlad},
  year = 2024,
